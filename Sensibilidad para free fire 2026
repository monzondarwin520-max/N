import React, { useState } from 'react';
import { Smartphone, Target, Settings, Copy, Share2, Download, RefreshCw } from 'lucide-react';

const SensitivityConfig = () => {
  const [selectedBrand, setSelectedBrand] = useState('');
  const [selectedModel, setSelectedModel] = useState('');
  const [selectedMode, setSelectedMode] = useState('');
  const [config, setConfig] = useState(null);
  const [configHistory, setConfigHistory] = useState([]);

  const brands = ['Samsung', 'Xiaomi', 'iPhone', 'Motorola', 'Realme', 'OPPO', 'Vivo', 'OnePlus', 'Huawei', 'Nokia', 'LG', 'Sony', 'Asus', 'Lenovo', 'Poco', 'Redmi', 'Honor', 'Tecno', 'Infinix'];
  
  const models = {
    'Samsung': ['Galaxy S25 Ultra', 'Galaxy S24', 'Galaxy S23', 'Galaxy A54', 'Galaxy M34', 'Galaxy A34', 'Galaxy S22', 'Galaxy A14'],
    'Xiaomi': ['Redmi Note 13 Pro', 'Poco X6', 'Redmi 12', 'Mi 11', 'Mi 12', 'Redmi Note 12', 'Mi 13', 'Poco F5'],
    'iPhone': ['iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 14', 'iPhone 13', 'iPhone 12', 'iPhone 11', 'iPhone SE 2022'],
    'Motorola': ['Edge 40', 'Moto G84', 'Edge 30', 'Moto G73', 'Edge 20', 'Moto G52', 'Moto G32'],
    'Realme': ['Realme 11 Pro', 'Realme GT Neo 3', 'Realme C55', 'Realme 10', 'Realme 9 Pro', 'Realme GT 2'],
    'OPPO': ['Reno 10 Pro', 'A78', 'Find X6', 'Reno 8', 'A77', 'Find N2', 'Reno 7'],
    'Vivo': ['V29', 'Y36', 'V27', 'X90', 'Y22', 'V25', 'Y16'],
    'OnePlus': ['OnePlus 11', 'OnePlus Nord 3', 'OnePlus 10 Pro', 'Nord CE 3', 'OnePlus 9'],
    'Huawei': ['P60 Pro', 'Nova 11', 'Mate 50', 'P50', 'Nova 10', 'Mate 40'],
    'Nokia': ['G60', 'X30', 'G400', 'C31', 'G21', 'X20'],
    'LG': ['Wing', 'Velvet', 'K52', 'K42', 'Q92'],
    'Sony': ['Xperia 1 V', 'Xperia 5 IV', 'Xperia 10 V', 'Xperia Pro-I'],
    'Asus': ['ROG Phone 7', 'Zenfone 10', 'ROG Phone 6', 'Zenfone 9'],
    'Lenovo': ['Legion Y90', 'K14', 'K13 Pro', 'K12 Pro'],
    'Poco': ['Poco X6 Pro', 'Poco F5', 'Poco M6 Pro', 'Poco C55', 'Poco X5'],
    'Redmi': ['Note 13 Pro+', 'Note 12 Turbo', 'K60', 'Note 11', '12C'],
    'Honor': ['Magic 5 Pro', 'X9a', 'X8a', '90 Pro', 'X7a'],
    'Tecno': ['Phantom X2', 'Camon 20', 'Pova 5', 'Spark 10', 'Pop 7'],
    'Infinix': ['Note 30', 'Hot 30', 'Zero 30', 'Smart 7', 'Note 12']
  };

  const modes = [
    { id: 'config1', name: '[CONFIG #1] - Ultra Pro', range: '160-180', icon: '⚡' },
    { id: 'config2', name: '[CONFIG #2] - Beast Mode', range: '170-190', icon: '🔥' },
    { id: 'config3', name: '[CONFIG #3] - Headshot King', range: '155-175', icon: '👑' },
    { id: 'config4', name: '[CONFIG #4] - God Tier', range: '165-185', icon: '💎' },
    { id: 'config5', name: '[CONFIG #5] - Pro Player', range: '150-170', icon: '🎯' },
    { id: 'config6', name: '[CONFIG #6] - Destroyer', range: '175-195', icon: '💥' },
    { id: 'config7', name: '[CONFIG #7] - Elite', range: '145-165', icon: '⭐' },
    { id: 'config8', name: '[CONFIG #8] - Legendary', range: '180-200', icon: '🏆' },
    { id: 'config9', name: '[CONFIG #9] - Master', range: '140-160', icon: '🔱' },
    { id: 'config10', name: '[CONFIG #10] - Supreme', range: '185-205', icon: '👹' }
  ];

  const generateRandomConfig = (mode) => {
    console.log('Generando config para modo:', mode);
    const baseConfigs = {
      config1: { general: [160, 180], redDot: [90, 110], scope2x: [75, 95], scope4x: [58, 78], freeView: [35, 50] },
      config2: { general: [170, 190], redDot: [98, 118], scope2x: [82, 102], scope4x: [65, 85], freeView: [35, 50] },
      config3: { general: [155, 175], redDot: [88, 108], scope2x: [72, 92], scope4x: [55, 75], freeView: [35, 50] },
      config4: { general: [165, 185], redDot: [95, 115], scope2x: [78, 98], scope4x: [60, 80], freeView: [35, 50] },
      config5: { general: [150, 170], redDot: [85, 105], scope2x: [70, 90], scope4x: [52, 72], freeView: [35, 50] },
      config6: { general: [175, 195], redDot: [102, 122], scope2x: [85, 105], scope4x: [68, 88], freeView: [35, 50] },
      config7: { general: [145, 165], redDot: [82, 102], scope2x: [68, 88], scope4x: [50, 70], freeView: [35, 50] },
      config8: { general: [180, 200], redDot: [105, 125], scope2x: [88, 108], scope4x: [70, 90], freeView: [35, 50] },
      config9: { general: [140, 160], redDot: [78, 98], scope2x: [65, 85], scope4x: [48, 68], freeView: [35, 50] },
      config10: { general: [185, 205], redDot: [108, 128], scope2x: [92, 112], scope4x: [72, 92], freeView: [35, 50] }
    };

    const base = baseConfigs[mode];
    
    if (!base) {
      console.error('No se encontró configuración para el modo:', mode);
      return null;
    }
    
    const random = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
    
    const dpiValue = random(200, 400);
    
    // Generar tamaño de botón
    const buttonSize = random(35, 50);
    
    // Calcular factor de ajuste basado en el tamaño del botón
    // Botón más pequeño (35) = sensibilidad más alta para compensar
    // Botón más grande (50) = sensibilidad más baja
    const buttonFactor = 1 + ((50 - buttonSize) / 100); // Factor entre 1.0 y 1.15
    
    // Aplicar factor a las sensibilidades
    const adjustSens = (min, max) => {
      const baseSens = random(min, max);
      return Math.round(baseSens * buttonFactor);
    };

    const tips = [
      '💡 Esta config funciona perfecta con TODAS las armas',
      '💡 Sensibilidad universal para todo tipo de combate',
      '💡 Úsala con cualquier arma del juego',
      '💡 Calibrada para máximo rendimiento general',
      '💡 Perfecta para francotiradores, rifles y SMGs',
      '💡 Config probada en todas las situaciones',
      '💡 Balance perfecto entre velocidad y precisión',
      '💡 Ideal para cualquier mapa y distancia',
      '💡 Compatible con todas las armas de Free Fire',
      '💡 Sensibilidad universal optimizada'
    ];

    const statuses = [
      '✓ Config universal para TODAS LAS ARMAS',
      '✓ Funciona perfecto con cualquier arma del juego',
      '✓ Sensibilidad balanceada universal',
      '✓ Compatible con francotiradores, rifles, SMGs y más',
      '✓ Configuración versátil para todo tipo de combate',
      '✓ Optimizada para cualquier estilo de juego'
    ];

    return {
      general: adjustSens(...base.general),
      redDot: adjustSens(...base.redDot),
      scope2x: adjustSens(...base.scope2x),
      scope4x: adjustSens(...base.scope4x),
      freeView: buttonSize,
      dpi: Math.random() > 0.5 ? 'ACTIVADO' : 'DESACTIVADO',
      dpiValue: dpiValue,
      status: statuses[Math.floor(Math.random() * statuses.length)],
      tip: tips[Math.floor(Math.random() * tips.length)],
      optimizations: `${modes.find(m => m.id === mode)?.icon}_CONFIG = PERFORMANCE_MAX`
    };
  };

  const handleGenerateConfig = (withDPI) => {
    if (!selectedBrand || !selectedModel || !selectedMode) {
      alert('⚠️ Selecciona marca, modelo y modo antes de generar');
      return;
    }
    
    const newConfig = generateRandomConfig(selectedMode);
    if (!withDPI) {
      newConfig.dpi = 'DESACTIVADO';
    } else {
      newConfig.dpi = 'ACTIVADO';
    }
    
    setConfig(newConfig);
    setConfigHistory(prev => [...prev.slice(-9), newConfig]);
  };

  const copyConfig = () => {
    const text = `🎮 CONFIGURACIÓN FREE FIRE PRO
━━━━━━━━━━━━━━━━━━━━━
📱 Dispositivo: ${selectedBrand} ${selectedModel}
🎯 Modo: ${modes.find(m => m.id === selectedMode)?.name}

⚙️ SENSIBILIDADES:
• General: ${config.general}
• Punto Rojo: ${config.redDot}
• Mira ×2: ${config.scope2x}
• Mira ×4: ${config.scope4x}
• Tamaño Botón: ${config.freeView}
• DPI: ${config.dpi}${config.dpi === 'ACTIVADO' ? ` (${config.dpiValue})` : ''}

${config.status}
${config.tip}

━━━━━━━━━━━━━━━━━━━━━
✨ Generado con FF Pro Config`;
    
    navigator.clipboard.writeText(text);
    alert('✅ ¡Configuración copiada al portapapeles!');
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900 text-green-400 font-mono p-4">
      {/* Header */}
      <div className="max-w-4xl mx-auto">
        <div className="bg-black/50 backdrop-blur border-2 border-green-500 rounded-lg p-4 mb-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <Target className="w-6 h-6" />
              <h1 className="text-xl font-bold">FF SENSITIVITY INFINITE</h1>
            </div>
            <div className="text-xs bg-red-600 text-white px-3 py-1 rounded">
              ∞ UNLIMITED
            </div>
          </div>
          <div className="text-xs mt-2 text-green-300">
            root@ff-hack:~# {new Date().toLocaleTimeString()}
          </div>
        </div>

        {/* Selección de Marca */}
        <div className="bg-black/80 border-2 border-green-500 rounded-lg p-4 mb-4">
          <div className="flex items-center gap-2 mb-3">
            <Smartphone className="w-5 h-5" />
            <span className="text-lg">[SELECCIONAR_MARCA]</span>
          </div>
          <select 
            value={selectedBrand}
            onChange={(e) => {
              setSelectedBrand(e.target.value);
              setSelectedModel('');
              setConfig(null);
            }}
            className="w-full bg-gray-800 border border-green-500 rounded p-3 text-green-400 focus:outline-none focus:border-green-300"
          >
            <option value="">&gt; Selecciona tu marca</option>
            {brands.map(brand => (
              <option key={brand} value={brand}>&gt; {brand}</option>
            ))}
          </select>
        </div>

        {/* Selección de Modelo */}
        {selectedBrand && (
          <div className="bg-black/80 border-2 border-green-500 rounded-lg p-4 mb-4">
            <div className="flex items-center gap-2 mb-3">
              <Settings className="w-5 h-5" />
              <span className="text-lg">[SELECCIONAR_MODELO]</span>
            </div>
            <select 
              value={selectedModel}
              onChange={(e) => {
                setSelectedModel(e.target.value);
                setConfig(null);
              }}
              className="w-full bg-gray-800 border border-green-500 rounded p-3 text-green-400 focus:outline-none focus:border-green-300"
            >
              <option value="">&gt; Selecciona tu modelo</option>
              {models[selectedBrand]?.map(model => (
                <option key={model} value={model}>&gt; {model}</option>
              ))}
            </select>
          </div>
        )}

        {/* Selección de Modo */}
        {selectedModel && (
          <div className="bg-black/80 border-2 border-green-500 rounded-lg p-4 mb-4">
            <div className="flex items-center gap-2 mb-3">
              <Target className="w-5 h-5" />
              <span className="text-lg">[MODO_SENSIBILIDAD]</span>
            </div>
            <select 
              value={selectedMode}
              onChange={(e) => {
                setSelectedMode(e.target.value);
                setConfig(null);
              }}
              className="w-full bg-gray-800 border border-green-500 rounded p-3 text-green-400 focus:outline-none focus:border-green-300"
            >
              <option value="">&gt; Selecciona modo de juego</option>
              {modes.map(mode => (
                <option key={mode.id} value={mode.id}>
                  &gt; {mode.icon} {mode.name} ({mode.range})
                </option>
              ))}
            </select>
          </div>
        )}

        {/* Configuración Generada */}
        {config && (
          <div className="bg-black/80 border-2 border-green-500 rounded-lg p-4 mb-4">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2">
                <Target className="w-5 h-5" />
                <span className="text-lg">[DEVICE: {selectedBrand} {selectedModel}]</span>
              </div>
              <div className="bg-red-600 text-white px-3 py-1 rounded text-xs font-bold">
                Config #{configHistory.length}
              </div>
            </div>

            <div className="bg-gray-900/80 border border-green-600 rounded p-4 mb-4">
              <div className="text-sm mb-2">{config.status}</div>
              <div className="text-yellow-400 text-xs">{config.tip}</div>
            </div>

            <div className="space-y-2 mb-4">
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; GENERAL:</span>
                <span className="text-2xl font-bold">{config.general}</span>
              </div>
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; PUNTO_ROJO:</span>
                <span className="text-2xl font-bold">{config.redDot}</span>
              </div>
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; MIRA_×2:</span>
                <span className="text-2xl font-bold">{config.scope2x}</span>
              </div>
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; MIRA_×4:</span>
                <span className="text-2xl font-bold">{config.scope4x}</span>
              </div>
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; TAMAÑO_BOTON:</span>
                <span className="text-2xl font-bold">{config.freeView}</span>
              </div>
              <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded">
                <span>&gt; ESTADO_DPI:</span>
                <span className={`text-lg font-bold ${config.dpi === 'ACTIVADO' ? 'text-green-400' : 'text-purple-400'}`}>
                  [{config.dpi}]
                </span>
              </div>
              {config.dpi === 'ACTIVADO' && (
                <div className="flex justify-between items-center bg-gray-900/50 p-3 rounded border-l-4 border-green-500">
                  <span>&gt; VALOR_DPI:</span>
                  <span className="text-2xl font-bold text-green-400">{config.dpiValue}</span>
                </div>
              ) }
            </div>

            <div className="bg-red-900/30 border border-red-500 rounded p-3 mb-4">
              <div className="text-xs text-center">
                🎯 [{config.optimizations}]
              </div>
            </div>

            <div className="grid grid-cols-3 gap-2 mb-3">
              <button 
                onClick={copyConfig}
                className="bg-blue-600 hover:bg-blue-700 text-white py-3 rounded font-bold flex items-center justify-center gap-2 transition-colors"
              >
                <Copy className="w-4 h-4" />
                [COPIAR]
              </button>
              <button 
                onClick={() => alert('✅ Función de compartir habilitada')}
                className="bg-green-600 hover:bg-green-700 text-white py-3 rounded font-bold flex items-center justify-center gap-2 transition-colors"
              >
                <Share2 className="w-4 h-4" />
                [SHARE]
              </button>
              <button 
                onClick={() => handleGenerateConfig(config.dpi === 'ACTIVADO')}
                className="bg-purple-600 hover:bg-purple-700 text-white py-3 rounded font-bold flex items-center justify-center gap-2 transition-colors"
              >
                <RefreshCw className="w-4 h-4" />
                [NUEVA]
              </button>
            </div>
          </div>
        )}

        {/* Botones de Generación */}
        {selectedMode && (
          <div className="space-y-3">
            <button 
              onClick={() => handleGenerateConfig(true)}
              className="w-full bg-green-600 hover:bg-green-700 text-white py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center gap-2"
            >
              <Download className="w-5 h-5" />
              &gt;&gt; [GENERAR_CON_DPI] &lt;&lt;
            </button>
            <button 
              onClick={() => handleGenerateConfig(false)}
              className="w-full bg-red-600 hover:bg-red-700 text-white py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center gap-2"
            >
              <Download className="w-5 h-5" />
              &gt;&gt; [GENERAR_SIN_DPI] &lt;&lt;
            </button>
            <div className="bg-yellow-900/30 border border-yellow-500 rounded p-3 text-center text-sm text-yellow-400">
              ⚡ Genera infinitas configuraciones - Cada una es única ⚡
            </div>
          </div>
        )}

        {/* Footer */}
        <div className="mt-6 text-center text-xs text-green-600">
          <p>⚡ CONFIGURACIONES ILIMITADAS PARA FREE FIRE 2025 ⚡</p>
          <p className="mt-1">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</p>
          {configHistory.length > 0 && (
            <p className="mt-2 text-purple-400">
              Total generadas: {configHistory.length} configs ∞
            </p>
          )}
        </div>
      </div>
    </div>
  );
};

export default SensitivityConfig;
